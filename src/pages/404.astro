---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page does not exist on the LS3 site.">
  <div class="wrap box">
    <p class="code num">404</p>
    <h1>That page isn't here</h1>
    <p class="p">
      The LS3 site moved when the lab moved to the University of Toronto, and some old links no
      longer resolve. Try one of these instead.
    </p>
    <div class="links">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-ghost" href="/publications/">Publications</a>
      <a class="btn btn-ghost" href="/people/">People</a>
      <a class="btn btn-ghost" href="/research/">Research</a>
    </div>
  </div>
</BaseLayout>

<style>
  .box {
    padding: var(--s-6) 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    align-items: flex-start;
  }
  .code {
    font-family: var(--f-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .2em;
    color: var(--yellow-deep);
    background: var(--yellow-soft);
    padding: 4px 10px;
    border-radius: 2px;
  }
  h1 { font-size: var(--t-h1); }
  .p { max-width: 52ch; color: var(--ink-2); }
  .links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: var(--s-1); }
</style>
