---
import Logo from './Logo.astro';
import settings from '../data/settings.json';

const year = new Date().getFullYear();
const a = settings.address;
---

<footer class="site-footer">
  <div class="wrap inner">
    <div class="col about">
      <Logo size={44} markOnly />
      <p class="name">{settings.labFullName}</p>
      <p class="body">
        {settings.institution}.<br />
        Directed by <a href="/people/">{settings.directorName}</a>.
      </p>

      {/* The university lockup, light and dark variants swapped by theme the
          same way the lab mark is — navy on near-black is unreadable. */}
      <a class="uoft" href="https://www.utoronto.ca/" rel="noopener" aria-label="University of Toronto">
        <img class="uoft-img has-dark" src="/uoft-logo.png" alt="University of Toronto" width="180" height="64" loading="lazy" />
        <img class="uoft-img only-dark" src="/uoft-logo-dark.png" alt="" aria-hidden="true" width="180" height="64" loading="lazy" />
      </a>
    </div>

    <div class="col">
      <h2>Lab</h2>
      <a href="/research/">Research</a>
      <a href="/publications/">Publications</a>
      <a href="/people/">People</a>
      <a href="/people/alumni/">Alumni</a>
    </div>

    <div class="col">
      <h2>Connect</h2>
      <a href="/join/">Join the lab</a>
      <a href="/contact/">Contact &amp; visiting</a>
      <a href={settings.links.faculty} rel="noopener">Faculty of Information</a>
      <a href="https://web.cs.toronto.edu/" rel="noopener">Computer Science</a>
    </div>

    <div class="col">
      <h2>Find us</h2>
      <p class="body">
        {a.line1}<br />{a.line2}<br />{a.line3}<br />{a.line4}
      </p>
    </div>
  </div>

  <div class="wrap base">
    <span>© {year} {settings.labName}, University of Toronto</span>
    <span class="dot" aria-hidden="true">·</span>
    <span>Built with Astro. <a href={settings.links.repo}>Source on GitHub</a></span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 3px solid var(--yellow);
    background: var(--surface);
    margin-top: var(--s-6);
    padding-top: var(--s-4);
  }

  .inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-3);
    padding-bottom: var(--s-4);
  }
  @media (min-width: 640px) { .inner { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .inner { grid-template-columns: 1.6fr 1fr 1fr 1.1fr; gap: var(--s-4); } }

  .col { display: flex; flex-direction: column; gap: 7px; align-items: flex-start; }

  .col h2 {
    font-family: var(--f-mono);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 3px;
  }

  .col a { font-size: var(--t-small); color: var(--ink-2); text-decoration: none; }
  .col a:hover { color: var(--blue-ink); text-decoration: underline; }

  .about { gap: 10px; }
  .about .name {
    font-family: var(--f-display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
    max-width: 24ch;
    line-height: 1.25;
  }
  .body { font-size: var(--t-small); color: var(--ink-2); line-height: 1.6; }
  .body a { text-decoration: underline; }

  .uoft { display: inline-block; margin-top: 4px; }
  /* No `display` here on purpose. `.uoft img` outscores `.uoft-img.only-dark`
     on specificity, so setting display:block here would defeat the theme swap
     below and show both variants at once. Display belongs to the swap rules. */
  .uoft img { height: auto; width: 180px; }
  .uoft:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; border-radius: 2px; }

  .uoft-img.has-dark { display: block; }
  .uoft-img.only-dark { display: none; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .uoft-img.has-dark { display: none; }
    :root:not([data-theme="light"]) .uoft-img.only-dark { display: block; }
  }
  :root[data-theme="dark"] .uoft-img.has-dark { display: none; }
  :root[data-theme="dark"] .uoft-img.only-dark { display: block; }
  :root[data-theme="light"] .uoft-img.has-dark { display: block; }
  :root[data-theme="light"] .uoft-img.only-dark { display: none; }

  .base {
    border-top: 1px solid var(--rule);
    padding-top: var(--s-2);
    padding-bottom: var(--s-3);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--f-mono);
    font-size: var(--t-meta);
    color: var(--ink-3);
  }
  .base a { color: var(--ink-3); }
  .dot { opacity: .5; }
</style>
