---
import { displayName, nameKey, TYPE_LABEL } from '../lib/format';

interface Props {
  pub: any;
  /** Loose keys of lab members, so their names render in bold. */
  labKeys: Set<string>;
  compact?: boolean;
  /** True on pages that already group entries under a year heading. */
  hideYear?: boolean;
}
const { pub, labKeys, compact = false, hideYear = false } = Astro.props;
const d = pub.data;
const L = (d.links ?? {}) as Record<string, string | undefined>;
// `pdf` is deliberately excluded: the title itself opens it, so a PDF chip
// beside it would be a second control doing the identical thing.
const links = Object.entries(L).filter(([k, v]) => !!v && k !== 'pdf') as [string, string][];

/*
 * Where the title points. A real link wins if there is one — PDF first, then
 * arXiv, then the DOI. Otherwise it falls back to a Google Scholar title
 * search, which reliably lands on the paper and its public copies.
 *
 * The fallback exists because none of the imported entries carries a link yet;
 * they came from DBLP, which has no full text. Add a `pdf` in the site editor
 * and that entry starts pointing at the real thing with no code change.
 */
const directHref = L.pdf || L.arxiv || L.doi;
const titleHref =
  directHref ?? `https://scholar.google.com/scholar?q=${encodeURIComponent(d.title)}`;
const titleHint = directHref
  ? 'Open the paper (new tab)'
  : 'Find this paper on Google Scholar (new tab)';

const abstract = (d.abstract ?? '').trim();
---

<article class:list={['pub', { compact }]}>
  <div class="meta">
    {!hideYear && <span class="yr num">{d.year}</span>}
    <span class="tag">{TYPE_LABEL[d.type] ?? d.type}</span>
  </div>

  <div class="body">
    <h3 class="title">
      <a href={titleHref} target="_blank" rel="noopener" title={titleHint}>{d.title}</a>
    </h3>

    {/* Rendered on one line on purpose: a newline between these spans becomes a
        literal space, which puts a gap before every comma. */}
    <p class="authors">{d.authors.map((a: string, i: number) => (<><span class:list={{ lab: labKeys.has(nameKey(a)) }}>{displayName(a)}</span>{i < d.authors.length - 1 ? <span class="sep">,&#32;</span> : null}</>))}</p>

    <p class="venue">
      {d.venueShort ? <span class="short">{d.venueShort}</span> : null}
      <span class="full">{d.venue}</span>
      {d.award ? <span class="award">{d.award}</span> : null}
    </p>

    {/* Chips and the abstract toggle share one wrapping row. When the abstract
        is open it claims a full row of its own, so the panel is never squeezed
        into a flex column beside the chips. */}
    <div class="actions">
      {links.map(([k, href]) => (
        <a class="lk" href={href} rel="noopener">{k.toUpperCase()}</a>
      ))}

      <details class="abs">
        <summary class="lk">Abstract</summary>
        <div class="panel">
          {abstract
            ? <p>{abstract}</p>
            : <p class="empty">No abstract available for this paper.</p>}
        </div>
      </details>
    </div>
  </div>
</article>

<style>
  .pub {
    display: grid;
    grid-template-columns: 1fr;
    gap: 6px;
    padding: var(--s-2) 0;
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 780px) {
    .pub { grid-template-columns: 108px minmax(0, 1fr); gap: var(--s-3); align-items: start; }
  }

  .meta { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; padding-top: 3px; }
  .yr {
    font-family: var(--f-mono);
    font-size: var(--t-small);
    font-weight: 600;
    color: var(--ink);
  }
  .meta .tag { font-size: 9.5px; }

  .body { display: flex; flex-direction: column; gap: 5px; }

  .title {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.32;
    letter-spacing: -0.01em;
    max-width: 66ch;
    text-wrap: pretty;
  }

  .authors { font-size: var(--t-small); color: var(--ink-2); line-height: 1.5; }
  .authors .lab { color: var(--ink); font-weight: 600; }
  .authors .sep { color: var(--ink-3); }

  .venue {
    font-family: var(--f-mono);
    font-size: var(--t-meta);
    color: var(--ink-3);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: baseline;
  }
  .venue .short {
    color: var(--blue-ink);
    font-weight: 600;
    background: var(--blue-soft);
    padding: 1px 6px;
    border-radius: 2px;
  }
  .venue .full { font-family: var(--f-body); font-size: var(--t-small); font-style: italic; }
  .venue .award {
    background: var(--yellow);
    color: #0E1626;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: 2px;
  }

  .title a {
    color: inherit;
    text-decoration: none;
  }
  .title a:hover { color: var(--blue-ink); text-decoration: underline; text-underline-offset: 2px; }
  .title a:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .actions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 2px; align-items: flex-start; }
  .lk {
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: .09em;
    text-decoration: none;
    color: var(--ink-2);
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    padding: 2px 7px;
  }
  .lk:hover { border-color: var(--blue); color: var(--blue-ink); background: var(--blue-soft); }

  /* ---- abstract disclosure ---------------------------------------------
     A <details> element, so opening and closing costs zero JavaScript and it
     still works with the keyboard and a screen reader for free. */

  .abs { flex: 0 0 auto; }
  /* Open, it takes a whole row so the prose gets the full width. */
  .abs[open] { flex: 1 0 100%; }

  .abs summary {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .abs summary::-webkit-details-marker { display: none; }

  /* The caret is drawn here rather than left to the browser, which renders it
     at a different size and position on every engine. */
  .abs summary::before {
    content: '';
    width: 0;
    height: 0;
    border-left: 4px solid currentColor;
    border-top: 3px solid transparent;
    border-bottom: 3px solid transparent;
    transition: transform 120ms ease;
  }
  .abs[open] summary::before { transform: rotate(90deg); }

  .abs summary:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }

  .abs[open] summary {
    border-color: var(--blue);
    color: var(--blue-ink);
    background: var(--blue-soft);
  }

  .panel {
    margin-top: 8px;
    padding: var(--s-1) var(--s-2);
    background: var(--surface-2);
    border-left: 2px solid var(--rule-strong);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: var(--t-small);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: var(--measure);
  }
  .panel .empty { color: var(--ink-3); font-style: italic; }

  @media (prefers-reduced-motion: reduce) {
    .abs summary::before { transition: none; }
  }

  .compact .title { font-size: 16px; }
</style>
